# Copy this file to .env and fill in your key.
# .env is already git-ignored, so your key never gets committed.
GROQ_API_KEY=your_groq_api_key_here

# Book a Demo form -> email to the team (optional; without these, requests
# are still saved in the demo_requests table). For Gmail use smtp.gmail.com
# with an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password_here
# SMTP_FROM=you@example.com
# DEMO_NOTIFY_TO=support@aikart.co
